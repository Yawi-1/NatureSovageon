    <style>
      
        /* SmallMenu  */

         .image-container {
            width: 180px;
            height: 180px;
            margin: 0 auto 15px;
        }
        
     .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        } 
         
   


        
    
        
      
  
        /* Product section styles */
        .product-section {
            text-align: center;
            padding: 20px 0;
            width: 100%;
        }
        
        .product-section h1 {
            font-size: 42px;
            color: #8B4513;
            margin-bottom: 15px;
            font-weight: bold;
        }
        
        .product-section p {
            color: #333;
            margin-bottom: 20px;
            font-size: 18px;
        }
        
        /* Stars rating */
        .stars {
            font-size: 24px;
            color: #FFD700;
            margin-bottom: 30px;
        }
        
        .stars .dark {
            color: #333;
        }
        
        /* Category buttons */
        .category-buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
        }
        
        .category-btn {
            padding: 12px 30px;
            border-radius: 25px;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .seeds-btn {
            background-color: #fff;
            color: #333;
            border: 2px solid #8B4513;
        }
        
        .masala-btn {
            background-color: #F9BF29;
            color: #333;
            border: none;
            font-weight: bold;
        }
        
        /* Spice image section */
        .spice-image {
            position: absolute;
            right: 0;
            max-width: 40%;
            height: auto;
        }
    
        
  
        
 
      
      

        
    </style>

